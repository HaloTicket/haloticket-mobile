{
  "expo": {
    "name": "HaloTicket Event Manager",
    "slug": "haloticket-mobile-app",
    "version": "1.0.0",
    "scheme": "haloticket",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "package": "vn.haloticket.eventmanager",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "db7564ae-294d-483a-bca1-b73c46df8c44"
      }
    },
    "owner": "wunguci"
  }
}
