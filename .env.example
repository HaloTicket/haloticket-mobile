# Địa chỉ API Gateway của backend.
# Thiết bị thật: dùng IP LAN cùng Wi-Fi với điện thoại (ví dụ http://192.168.1.100:8888/api).
# Không dùng localhost, 127.0.0.1 hay IP ảo (vEthernet, WSL, Docker 172.x.x.x) vì điện thoại không tới được.
# Android Emulator trên cùng máy: http://10.0.2.2:8888/api
EXPO_PUBLIC_API_URL=http://192.168.1.x:8888/api

# Keycloak (đăng nhập)
EXPO_PUBLIC_KEYCLOAK_URL=
EXPO_PUBLIC_KEYCLOAK_REALM=
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=
